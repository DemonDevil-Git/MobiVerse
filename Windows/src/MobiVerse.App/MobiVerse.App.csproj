<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AssemblyName>MobiVerse</AssemblyName>
    <RootNamespace>MobiVerse.App</RootNamespace>
    <ApplicationIcon Condition="Exists('Resources\MobiVerse.ico')">Resources\MobiVerse.ico</ApplicationIcon>
    <Version>2.3.1</Version>
    <AssemblyVersion>2.3.1.0</AssemblyVersion>
    <FileVersion>2.3.1.12</FileVersion>
    <InformationalVersion>2.3.1+12</InformationalVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MobiVerse.Core\MobiVerse.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\..\Sources\Mobi2EpubTransfer\Resources\hero-books-background.png" Link="Resources\hero-books-background.png" />
    <Resource Include="..\..\..\Sources\Mobi2EpubTransfer\Resources\reading-still-life.png" Link="Resources\reading-still-life.png" />
    <Resource Include="..\..\..\Sources\Mobi2EpubTransfer\Resources\reading-still-life-dark.png" Link="Resources\reading-still-life-dark.png" />
    <Resource Include="Resources\MobiVerse.ico" Condition="Exists('Resources\MobiVerse.ico')" />
  </ItemGroup>
</Project>
