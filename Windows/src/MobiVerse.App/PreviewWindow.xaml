<Window x:Class="MobiVerse.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="1100" Height="760" MinWidth="720" MinHeight="520" Background="Black"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseWheel="Window_PreviewMouseWheel">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#FFFAFAFA" Padding="16,8">
      <Grid>
        <StackPanel><TextBlock x:Name="TitleLabel" FontWeight="SemiBold" FontSize="14" Foreground="#142A33" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ModeLabel" FontSize="11" Foreground="#88142A33"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="FullScreenButton" Content="⛶" Width="38" Click="FullScreen_Click" ToolTip="Enter full screen"/>
          <Button Content="✕" Width="38" Click="Close_Click" ToolTip="Close preview"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Background="Black">
      <ScrollViewer x:Name="ImageScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid Background="Black">
          <Image x:Name="PageImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image.LayoutTransform><ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/></Image.LayoutTransform>
          </Image>
        </Grid>
      </ScrollViewer>
      <wv2:WebView2 x:Name="WebPreview" Visibility="Collapsed"/>
    </Grid>

    <Border x:Name="ImageControls" Grid.Row="2" Background="#FFFAFAFA" Padding="12,8">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="PreviousButton" Grid.Column="0" Content="◀" Width="38" Click="Previous_Click" ToolTip="Previous"/>
        <Slider x:Name="PageSlider" Grid.Column="1" Margin="12,0" IsSnapToTickEnabled="True" ValueChanged="PageSlider_ValueChanged"/>
        <TextBlock x:Name="PageLabel" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Center" Foreground="#88142A33"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal">
          <Button Content="−" Width="38" Click="ZoomOut_Click" ToolTip="Zoom out"/>
          <Button Content="Fit" Width="48" Click="Fit_Click"/>
          <Button Content="＋" Width="38" Click="ZoomIn_Click" ToolTip="Zoom in"/>
          <Button x:Name="NextButton" Content="▶" Width="38" Click="Next_Click" ToolTip="Next"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
