<Window x:Class="MobiVerse.App.ImportReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review imported books" Width="840" Height="610" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Paper}" Foreground="{StaticResource Ink}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
    <local:InverseBooleanToVisibilityConverter xmlns:local="clr-namespace:MobiVerse.App" x:Key="InverseBooleanVisibility"/>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Review imported books" FontFamily="Georgia" FontSize="25" FontWeight="SemiBold"/>
      <TextBlock Text="MobiVerse analyzed each file locally. Confirm the reading layout before continuing."
                 Foreground="#99142A33" Margin="0,5,0,18"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,12" Padding="14" CornerRadius="16" Background="#CCFFFFFF" BorderBrush="#18142A33" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
                <Border Width="52" Height="70" CornerRadius="10" Background="#12142A33" VerticalAlignment="Center">
                  <TextBlock Text="▤" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,14,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Classification.Evidence}" FontSize="12" Foreground="#99142A33" Margin="0,5,0,0" TextWrapping="Wrap" MaxHeight="36"/>
                  <TextBlock Text="{Binding ConfidenceLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ConfidenceBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="✓  Ready to read" Foreground="{StaticResource Sage}" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsEpub, Converter={StaticResource BooleanVisibility}}"/>
                <ComboBox Grid.Column="2" Margin="4" ItemsSource="{Binding ProfileChoices}" DisplayMemberPath="Title" SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="Selection_Changed"
                          Visibility="{Binding IsEpub, Converter={StaticResource InverseBooleanVisibility}}"/>
                <ComboBox Grid.Column="3" Margin="4" ItemsSource="{Binding DirectionChoices}" DisplayMemberPath="Title" SelectedValuePath="Value"
                          SelectedValue="{Binding ReadingDirection, Mode=TwoWay}" Visibility="{Binding DirectionVisibility}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Text="No book content leaves this PC." FontSize="12" Foreground="#88142A33" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Width="92" Click="Cancel_Click"/>
        <Button x:Name="ConfirmButton" Content="Add to shelf" Width="120" Margin="8,3,0,3" Background="{StaticResource Sage}" Foreground="White" BorderThickness="0" Click="Confirm_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
